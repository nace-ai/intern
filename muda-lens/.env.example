# Copy to .env and fill in. .env is git-ignored.

# --- Drex (Nace.AI) ---
# Hosted API: base URL from console.nace.ai/docs (API reference -> systemone)
# Local open weights: python serve.py from github.com/nace-ai/drex-decision-models -> http://127.0.0.1:8000
DREX_BASE_URL=
# or NACE_API_KEY=nace_sk_...
DREX_API_KEY=
DREX_MODEL=drex-v2.0
DREX_PATH=/v1/systemone
DREX_PRICE_PER_MTOK=0.06

# --- Frontier LLM baseline ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
