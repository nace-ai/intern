# Safe development default: Training works without credentials.
HEIST_OFFLINE=true
# To enable BYOK Live, set HEIST_OFFLINE=false and configure server Groq.
# Players supply their own Nace key through the Live form, never this file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Historical offline evaluation infrastructure; HTTP developer-key Live is blocked.
LIVE_ENABLED=false
# Never use VITE_ variables for credentials.
