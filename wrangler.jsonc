{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-heist",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "vars": { "ENABLE_LIVE": "false" },
  "durable_objects": { "bindings": [
    { "name": "ARENA", "class_name": "Arena" },
    { "name": "PROVIDER_QUOTA", "class_name": "ProviderQuota" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Arena", "ProviderQuota"] }],
  "observability": { "enabled": false }
}
