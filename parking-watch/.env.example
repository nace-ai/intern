# LOCAL LAPTOP DEMO (bind only to 127.0.0.1; localhost is secure for webcam use)
WATCH_KEY=
REQUIRE_AUTH=false
DEMO_MODE=true
# Send an SMS on the first plausible three-wheeler sighting during a demo.
THREE_WHEEL_DEMO_ALERTS=false

# Hackathon AI: get a key from Nace AI console. Do not put this key in the browser.
VISION_PROVIDER=drex
# Never use the key visible in a shared screenshot. Revoke it and paste a fresh key locally.
NACE_API_KEY=
# Optional: to test workspace Search, put SFMTA parking files in a Ready workspace.
NACE_WORKSPACE_ID=
# Optional workspace file for NDI when Nace cannot fetch the public brochure URL.
SFMTA_NDI_WORKSPACE_ID=
SFMTA_NDI_FILE_ID=
NACE_MODEL=drex-max-v1.1
CONFIDENCE_THRESHOLD=0.76
SIGHTING_HITS=2
DEPARTURE_MISSES=2
DEPARTURE_COOLDOWN_SECONDS=30
SCAN_INTERVAL_MS=1800

# OpenAI is an optional comparison baseline; NOT required for the Wildcard track.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Use trial for the current Twilio free trial, or standard for custom messages.
TWILIO_MODE=standard
TWILIO_TRIAL_TEMPLATE=sms_internal_alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Required for standard mode. For trial mode, use the assigned sender if shown in the Console API example.
TWILIO_FROM=
ALERT_TO=

# The server persists event history locally. No camera frames are saved.
DATABASE_PATH=./parking_watch.sqlite3
