/* Paper, ink and the mascot's violet: see theme.py for the colours. */

Screen {
    layout: vertical;
    background: $background;
    color: $foreground;
}

#status {
    dock: top;
    height: auto;
    padding: 0 1;
    background: $surface;
    border-bottom: solid $rule;
}

#body {
    height: 1fr;
}

#transcript {
    width: 1fr;
    height: 1fr;
    padding: 0 2;
}

#side {
    width: 32%;
    min-width: 56;
    max-width: 88;
    height: 1fr;
    border-left: solid $rule;
}

#system1 {
    height: 3fr;
    padding: 0 1;
    border-bottom: solid $rule;
}

#state {
    height: 2fr;
    padding: 0 1;
}

#prompt {
    dock: bottom;
    height: auto;
    max-height: 10;
    margin: 0 1 0 1;
    background: $surface;
    border: solid $rule;
}

#prompt:focus {
    border: solid $brand;
}

#transcript-header, #state-header, #system1-header {
    dock: top;
    height: 1;
    background: $select;
}

/* A side panel's section: its name on a hairline, what it holds under it. */
.titled {
    height: auto;
    margin-top: 1;
    border-top: solid $rule;
    border-title-color: $muted;
    border-title-style: bold;
}

/* The System 1 panel (system1_panel.py): what the asks came to stays put, the judgements scroll. */
#system1-usage {
    height: auto;
    margin-top: 1;
}

/* The State panel (state_panel.py): the budget, the goal and what runs stay put, the history scrolls. */
#cut-budget {
    height: auto;
    margin-top: 1;
}

#system1-feed, #cut-history {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

/* The entering page (welcome.py): centred; on a wide terminal the mascot between its two systems (hero), on a
   narrower one all of it in a frame (framed), on a small one the frame alone (compact). */
#welcome {
    height: auto;
}

#welcome-wordmark, #welcome-title, #welcome-about, #welcome-foot, #welcome-tips {
    width: auto;
    height: auto;
}

#welcome-title, #welcome-about, #welcome-row, #welcome-foot, #welcome-tips {
    margin-top: 1;
}

#welcome-row, #welcome-side, #welcome-mascot, #welcome-where, #welcome .card {
    height: auto;
}

#welcome-mascot {
    width: 32;
}

/* hero */
#welcome.hero #welcome-row {
    width: auto;
    align-vertical: middle;
}

#welcome.hero .card {
    width: 44;
    padding: 1 2;
    border: round $brand 45%;
    border-title-color: $brand;
    border-title-style: bold;
}

#welcome.hero #welcome-side {
    width: 38;
    padding: 0 3;
}

#welcome.hero #welcome-where, #welcome.short #welcome-wordmark {
    display: none;
}

/* framed, and compact */
#welcome.framed #welcome-row, #welcome.compact #welcome-row {
    width: 100%;
    max-width: 124;
    padding: 1 2;
    border: round $brand;
    border-title-color: $brand;
    border-title-style: bold;
    border-title-align: center;
}

#welcome.framed #welcome-side {
    width: 36;
}

#welcome.framed #welcome-where {
    margin-top: 1;
}

#welcome.framed #welcome-system1, #welcome.compact #welcome-system1 {
    width: 1fr;
}

#welcome.framed #welcome-system2, #welcome.framed #welcome-title, #welcome.framed #welcome-foot,
#welcome.compact #welcome-system2, #welcome.compact #welcome-title, #welcome.compact #welcome-foot,
#welcome.compact #welcome-wordmark, #welcome.compact #welcome-about, #welcome.compact #welcome-side {
    display: none;
}

#welcome.compact #welcome-row {
    margin-top: 0;
    padding: 0 1;
}

.section {
    margin-top: 1;
}

.section.first {
    margin-top: 0;
}

.line {
    height: auto;
}

.quote {
    height: auto;
    margin-top: 1;
    padding: 0 1;
    background: $wash;
}

.line .mark {
    width: 2;
}

.line .body {
    width: 1fr;
}

/* The user's message: a purple bar and a deeper shade, so it stands apart from the harness's blocks when scrolling. */
.user {
    margin: 1 0 1 0;
    padding: 0 1;
    background: $select;
    border-left: outer $brand;
    color: $foreground;
}

.reply {
    margin: 0;
    padding: 0;
    background: transparent;
}

.marker {
    color: $muted;
}

.decision {
    height: auto;
    background: $surface;
    border-left: wide $muted;
    padding: 0 2;
    margin: 0 0 1 0;
}

.decision.refused {
    border-left: wide $error;
}

/* System 1's look at a background command that it told the agent of. */
.decision.told {
    border-left: wide $warning;
}

/* A compaction's card, open: the summary System 2 continues from, under what the card says. */
.compaction-summary {
    height: auto;
    margin-top: 1;
}

.tool .decision {
    margin: 0;
    padding: 0 1;
    background: $wash;
    border-left: none;
}

.notice.warn {
    color: $warning;
}

.notice.error {
    color: $error;
}

.notice.ok {
    color: $success;
}

.notice.info {
    color: $muted;
}

.thinking {
    color: $muted;
    text-style: italic;
    margin: 0 0 1 0;
}

.tool {
    height: auto;
    margin: 0 0 1 0;
}

/* A tool call, the harness's: a lighter shade, softer ink, no bar. */
.tool .head {
    background: $wash;
    color: $primary;
    padding: 0 1;
}

.tool.failed .head {
    color: $error;
}

.tool .out {
    padding: 0 1;
}

.reply MarkdownBlock > .code_inline {
    background: $wash !important;
    color: $foreground !important;
    text-style: none !important;
}

ModelPicker, StateScreen {
    align: center middle;
    background: $background 60%;
}

#picker {
    width: 112;
    max-width: 96%;
    height: 80%;
    border: round $rule;
    background: $surface;
    padding: 0 1;
}

#picker-filter {
    margin: 0 0 1 0;
    background: $surface;
    border: solid $rule;
}

#picker-filter:focus {
    border: solid $brand;
}

#picker-title, #picker-hint, #picker-thinking {
    height: auto;
}

#picker-options {
    height: 1fr;
    background: $surface;
    border: none;
}

#state-full {
    width: 90%;
    height: 90%;
    border: round $rule;
    background: $surface;
    padding: 1 1 0 1;
}

#state-cut {
    height: 1fr;
    border: none;
    background: $surface;
}

.state-note {
    height: auto;
    margin-bottom: 1;
}

/* the setup screen (onboarding.py) */
OnboardingScreen {
    background: $background;
    align: center middle;
}

#setup {
    width: 100%;
    height: auto;
    max-height: 100%;
}

#setup-wordmark, #setup-stages, #setup-keys {
    width: auto;
    height: auto;
}

#setup-stages {
    margin: 1 0 1 0;
}

#setup-card {
    width: 100;
    max-width: 96%;
    height: auto;
    max-height: 100%;
    border: round $brand 45%;
    background: $surface;
    padding: 1 2;
}

#setup-intro {
    height: auto;
}

#setup-intro #welcome-mascot {
    margin: 0 3 0 0;
}

#setup-about {
    width: 1fr;
    height: auto;
}

#setup-title, #setup-body, #setup-status {
    height: auto;
}

#setup-body {
    margin: 0 0 1 0;
}

#setup-status {
    margin: 1 0 0 0;
}

#setup-filter, #setup-input {
    margin: 0 0 1 0;
    background: $surface;
    border: solid $rule;
}

#setup-filter:focus, #setup-input:focus {
    border: solid $brand;
}

#setup-options {
    height: auto;
    max-height: 20;
    background: $surface;
    border: none;
}

#setup-keys {
    margin: 1 0 0 0;
}
