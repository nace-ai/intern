# Copy to .env and fill in your values. Never commit .env.

# Required to use the Nace Drex API. Leave empty to use the offline policy fallback.
NACE_API_KEY=

# Nace Drex endpoint and model (defaults shown are the production values).
NACE_ENDPOINT=https://console.nace.ai/v1/systemone
NACE_MODEL=drex-max-v1.1
DREX_TEMPERATURE=0
