# Names this project reads from .env (git-ignored, mode 600). Do not put values in this file.
# Fill the empty ones with a hidden prompt:   python3 tools/set_secret.py --missing
# See what is set (names only):               python3 tools/set_secret.py --list

# Drex and NDI. Needed for every live run. https://console.nace.ai/dashboard/api-keys
NACE_API_KEY=

# System 2 for Intern and the courtroom speeches (Qwen on DeepInfra). https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=

# Slack bridge (Socket Mode). Create the app from slack/manifest.yaml: bash tools/setup_demo.sh --slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional: every message in this channel starts a trial (otherwise only @mentions do).
SLACK_CHANNEL_ID=

# Optional: Keenable web search. Without it the keyless public endpoint is used.
KEENABLE_API_KEY=
