 "section": "440.205",
 "citation": "Fla. Stat. § 440.205",
 "title": "Coercion of employees",
 "status": "active",
 "text": "No employer shall discharge, threaten to discharge, intimidate, or coerce any employee by reason of such employee’s valid claim for compensation or attempt to claim compensation under the Workers’ Compensation Law.",
