# Copy to .env (git-ignored). Server-side only: never commit, log, or ship to the browser.

# Nace Drex key (format: nace_sk_...). Required for decisions to be labeled DREX: LIVE.
NACE_API_KEY=
NACE_DEFAULT_DECISION_MODEL=drex-latest

# Meta model API key (optional LLM comparison provider). LLAMA_API_KEY is accepted as an alias.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_DECISION_MODEL=muse-ember-1.0

PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=./data/vice-exchange.sqlite
GAME_TICK_HZ=10
NPC_DECISION_CONCURRENCY=4
MAX_DECISION_CALLS_PER_MIN=60
# Also ask Meta in the background for each live Drex decision (never applied). Default on when both keys exist.
SHADOW_META=1

# Grants demo-director controls (reset, incident, mode switch, experiment) to a join that presents it.
# Empty = the server prints a per-run secret at boot, and the first browser to join VICE-42 is the director.
DEMO_DIRECTOR_SECRET=

# UDP fast path for native world clients. Empty = HTTP port + 1. VICE_UDP=0 disables it.
UDP_PORT=
