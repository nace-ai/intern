{
  "name": "@vice/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared commands, events, snapshots and Zod schemas. Consumed as TypeScript source (no build step).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
