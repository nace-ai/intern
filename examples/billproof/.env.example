# BillProof environment keys: NAMES ONLY. Copy to .env and fill locally; .env is gitignored and never committed.
# Leave anything blank to use the mock/fixture adapter (shown as SIMULATED in the UI).

# --- Nace AI: Drex decision model + NDI document intelligence ---
NACE_API_KEY=
NACE_BASE_URL=https://console.nace.ai
# Published scored rows use drex-max-v1.1. drex-max-finance is the example default and a separately reported model.
DREX_MODEL=drex-max-finance
# Only if you have direct NDI keys (ndi_sk_) instead of console keys
NDI_API_KEY=
NDI_BASE_URL=https://ndi-api.nace.ai/api/v1

# --- Frontier LLM via an OpenAI-compatible endpoint ---
# FRONTIER_PROVIDER=deepinfra selects DeepInfra for the comparison models and Intern's System 2.
FRONTIER_PROVIDER=
FRONTIER_BASE_URL=
FRONTIER_API_KEY=
FRONTIER_MODEL=

# DeepInfra. Read when FRONTIER_PROVIDER=deepinfra, and for Intern's System 2.
# DEEPINFRA_BASE_URL is the OpenAI-compatible base. DEEPINFRA_MODEL is required
# for a Live DeepInfra call unless the caller passes a model.
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=
DEEPINFRA_MODEL=

# Leave blank. v1 does not call these.
BRIGHTDATA_API_TOKEN=
APIFY_TOKEN=

# --- Pricing for cost per case (USD per 1M input tokens); verify before a live run ---
DREX_PRICE_PER_MTOK=0.03
FRONTIER_PRICE_PER_MTOK_INPUT=
FRONTIER_PRICE_PER_MTOK_OUTPUT=

# --- Mode: auto = real adapter when its key is set, else mock · 1 = force mocks · 0 = require real ---
MOCK_MODE=auto
