{
  "name": "agent-heist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "evaluate": "tsx server/evaluate.ts",
    "check:worker": "tsc -p worker/tsconfig.json",
    "build:worker": "npm run build && npm run check:worker && wrangler deploy --dry-run --outdir worker-dist",
    "dev:worker": "wrangler dev --port 8790",
    "benchmark": "tsx benchmarks/run.ts",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "test:launcher": "node scripts/test-launcher.mjs",
    "audit:repo": "node scripts/audit-repository.mjs",
    "verify:clean": "node scripts/verify-clean-checkout.mjs",
    "verify:public": "node scripts/verify-public.mjs",
    "qr:generate": "node scripts/generate-qr.mjs",
    "demo:pdfs": "node scripts/generate-demo-pdfs.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "nace-sdk": "0.7.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.0",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
